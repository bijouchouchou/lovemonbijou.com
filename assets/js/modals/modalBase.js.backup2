// assets/js/modals/modalBase.js - VERSION CORRIGÉE
import { theme } from '../core/theme.js';

export class ModalBase {
    constructor(modalId, options = {}) {
        this.modal = document.getElementById(modalId);
        if (!this.modal) {
            console.warn(`Modal ${modalId} non trouvée dans le DOM`);
            // Créer la structure si elle n'existe pas
            this.createModalStructure(modalId);
        }
        
        // Chercher les éléments DANS la modale
        this.modalContent = this.modal?.querySelector('.modal-content');
        this.closeBtn = this.modal?.querySelector('.close-modal');
        
        // Options avec couleurs par défaut
        this.options = {
            bgColor: theme.cream.light,
            borderColor: theme.gold.medium,
            textColor: theme.brown.dark,
            closeColor: theme.brown.light,
            ...options
        };
        
        this.initEvents();
        this.applyModalStyles();
    }

    createModalStructure(modalId) {
        console.log(`Création de la structure pour ${modalId}`);
        const modalHTML = `
            <div id="${modalId}" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 10000;">
                <div class="modal-content" style="position: relative; margin: 50px auto; max-width: 800px; padding: 20px;">
                    <!-- Contenu dynamique -->
                </div>
                <button class="close-modal" style="position: absolute; top: 15px; right: 15px; background: none; border: none; font-size: 1.8rem; color: white; cursor: pointer; z-index: 10001;">×</button>
            </div>
        `;
        document.body.insertAdjacentHTML('beforeend', modalHTML);
        
        // Réassigner les références
        this.modal = document.getElementById(modalId);
        this.modalContent = this.modal.querySelector('.modal-content');
        this.closeBtn = this.modal.querySelector('.close-modal');
    }

    applyModalStyles() {
        if (!this.modal) return;
        
        // Style du fond de la modale
        this.modal.style.backgroundColor = 'rgba(0,0,0,0.5)';
        
        // Style du bouton fermer
        if (this.closeBtn) {
            this.closeBtn.style.position = 'absolute';
            this.closeBtn.style.top = '15px';
            this.closeBtn.style.right = '15px';
            this.closeBtn.style.background = 'none';
            this.closeBtn.style.border = 'none';
            this.closeBtn.style.fontSize = '1.8rem';
            this.closeBtn.style.cursor = 'pointer';
            this.closeBtn.style.zIndex = '10001';
            this.closeBtn.style.color = this.options.closeColor;
            
            // Hover effect
            this.closeBtn.addEventListener('mouseenter', () => {
                this.closeBtn.style.color = theme.gold.medium;
                this.closeBtn.style.transform = 'scale(1.2)';
            });
            
            this.closeBtn.addEventListener('mouseleave', () => {
                this.closeBtn.style.color = this.options.closeColor;
                this.closeBtn.style.transform = 'scale(1)';
            });
        }
    }

    initEvents() {
        if (!this.modal) return;
        
        // Fermer avec le bouton ×
        if (this.closeBtn) {
            this.closeBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                this.close();
            });
        }
        
        // Fermer en cliquant en dehors du contenu
        this.modal.addEventListener('click', (e) => {
            // Vérifier si on clique sur l'arrière-plan (pas sur le contenu)
            if (e.target === this.modal) {
                this.close();
            }
        });
        
        // Fermer avec ESC
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && this.modal.style.display === 'block') {
                this.close();
            }
        });
    }

    open() {
        if (!this.modal) return;
        
        this.modal.style.display = 'block';
        document.body.style.overflow = 'hidden';
        
        // Animation d'ouverture
        this.modal.style.opacity = '0';
        setTimeout(() => {
            this.modal.style.opacity = '1';
            this.modal.style.transition = 'opacity 0.3s ease';
        }, 10);
    }

    close() {
        if (!this.modal) return;
        
        this.modal.style.opacity = '0';
        setTimeout(() => {
            this.modal.style.display = 'none';
            document.body.style.overflow = 'auto';
            this.modal.style.transition = 'none';
        }, 300);
    }

    setContent(content) {
        if (this.modalContent) {
            this.modalContent.innerHTML = content;
        }
    }
}
